{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.byahero.app/api/:path*" },
    { "source": "/assets/images/uploads/:path*", "destination": "https://api.byahero.app/assets/images/uploads/:path*" },
    { "source": "/routes/:path*", "destination": "https://api.byahero.app/routes/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
