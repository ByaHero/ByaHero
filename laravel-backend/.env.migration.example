# READ-ONLY source: current alwaysdata MySQL. Never used by the running app.
SOURCE_DB_HOST=mysql-byahero.alwaysdata.net
SOURCE_DB_PORT=3306
SOURCE_DB_DATABASE=
SOURCE_DB_USERNAME=
SOURCE_DB_PASSWORD=
# Optional CA file for a TLS connection to MySQL.
SOURCE_DB_SSL_CA=
SOURCE_ASSET_BASE_URL=https://byahero.alwaysdata.net
# Test snapshots omit sessions, caches, queued jobs, reset codes, and device tokens.
MIGRATION_SKIP_DATA=sessions,cache,cache_locks,jobs,job_batches,failed_jobs,password_resets,password_reset,password_reset_tokens,user_fcm_tokens
