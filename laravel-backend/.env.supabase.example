# Separate test environment. Do not copy these settings into alwaysdata's .env.
APP_NAME="ByaHero Test"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-TEST-BACKEND.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
VERCEL_CONTAINER=1
ADMIN_TEST_ENABLED=true

DB_CONNECTION=pgsql
# From Supabase > Connect > Session pooler. Use port 5432 for migrations.
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.dvkpbydrrpurlbjsjlux
DB_PASSWORD=
DB_SCHEMA=byahero_test
DB_SSLMODE=require
DB_TIMEZONE=Asia/Manila
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_COOKIE=byahero_test_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
CACHE_STORE=database
CACHE_PREFIX=byahero_test_
QUEUE_CONNECTION=sync

# Exact frontend origins used for testing, comma separated. No trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BUS_LOCATION_STORE=database
UPLOAD_STORE=supabase
SUPABASE_URL=https://dvkpbydrrpurlbjsjlux.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=byahero-test-uploads

# Keep copied production users isolated from test activity.
EXTERNAL_NOTIFICATIONS_ENABLED=false
PYTHON_ML_ENABLED=false
MAIL_MAILER=log
